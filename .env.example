# ——— Origin situs ———
#
# WAJIB DISET DI PRODUKSI. Dipakai app/layout.tsx (metadataBase), app/sitemap.ts,
# dan app/robots.ts. Tanpa origin absolut yang benar, crawler mengabaikan
# og:image dan sitemap menunjuk ke mesin yang salah.
#
# Kalau kosong, build produksi GAGAL — bukan diam-diam jatuh ke localhost
# (lihat lib/site-url.ts). Nilai yang terisi localhost juga digagalkan, tapi
# hanya di build Vercel, supaya `pnpm build` di laptop tetap bisa dijalankan.
# Di dev (`pnpm dev`) fallback http://localhost:3000 tetap berlaku.
#
# Slash di akhir tidak masalah — origin-nya dinormalkan.
NEXT_PUBLIC_SITE_URL=https://contoh.com

# Guestbook (Supabase) — salin ke .env.local, isi, lalu set juga di Vercel
# (Project Settings → Environment Variables).
#
# TIGA-TIGANYA SERVER-ONLY. Jangan pernah menambahkan prefix NEXT_PUBLIC_:
# service role key bypass RLS, dan begitu ia terekspos ke browser siapa pun bisa
# membaca/menghapus seluruh tabel.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...).
# Project lama memakai kunci JWT `service_role`; keduanya sama-sama diterima
# supabase-js dan sama-sama mem-bypass RLS. Nama variabelnya tidak berubah.
SUPABASE_SERVICE_ROLE_KEY=

# Salt untuk hash IP yang dipakai rate limit. Isi string acak panjang, mis.
#   openssl rand -hex 32
# Kalau kosong, kode jatuh ke service role key sebagai salt (cukup untuk dev).
GUESTBOOK_SALT=

# ——— Kursor live (Supabase Realtime) ———
#
# DUA ini SENGAJA `NEXT_PUBLIC_` — memang harus sampai ke browser. Anon key
# dirancang untuk publik: ia tunduk pada RLS, dan tabel `guestbook` RLS-on tanpa
# policy, jadi anon key tidak bisa membaca/menulis apa pun di sana. Yang
# dipakainya hanya channel Realtime, yang tak menyentuh tabel sama sekali.
#
# Kalau dua-duanya dikosongkan, fitur kursor mati diam-diam dan sisa situs
# jalan normal.
#
# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...).
# Project lama memakai kunci JWT `anon`. Terverifikasi: kunci publishable
# diterima REST maupun Realtime, jadi kursor live jalan dengan keduanya.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
